OWM_API_KEY=your_openweathermap_api_key

# MQTT (ไม่บังคับ) - ค่าเริ่มต้นใช้ broker สาธารณะของ HiveMQ ไม่ต้องมี user/password
# เป็น broker สาธารณะ ใครรู้ topic ก็สั่ง relay ได้ ควรตั้ง MQTT_BASE_TOPIC เป็นชื่อที่เดายาก
# MQTT_HOST=broker.hivemq.com
# MQTT_PORT=1883
# MQTT_BASE_TOPIC=hwclass/esp32-yourname

